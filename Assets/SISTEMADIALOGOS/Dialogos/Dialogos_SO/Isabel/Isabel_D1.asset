%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Isabel_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Disculpe que la importune, se\xF1orita Isabel. Mi nombre es Horacio,
      detective. Me han encomendado investigar el asunto de las milanesas desaparecidas. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Un gusto, detective. S\xED, he o\xEDdo que lo han llamado para encargarse
      del asunto."
    nombre: "Isabel Alvear, Esposa de Hip\xF3lito"
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "El gusto es m\xEDo, se\xF1orita Isabel. Aunque debo confesarle que
      me cost\xF3 un buen rato dar con usted."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Oh, s\xED... suelo tomarme mi tiempo para estar presentable. No me
      gusta que me vean despintada ni con una facha poco decorosa."
    nombre: Elisa, ama de llaves
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: Comprendo. Una dama que cuida mucho su apariencia...
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Bueno, vamos al grano... \xBFHay alg\xFAn motivo para desconfiar de
      usted en este asunto?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1\xA1De mi!! \xA1De ninguna manera! Yo jam\xE1s le hincar\xEDa el
      diente a semejante cosa."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFLas milanesas no son de su agrado?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1Ni por asomo! Esas milanesas est\xE1n cargadas de grasa. Una cosa
      as\xED me resulta sencillamente repugnante. Ser\xEDa un desperdicio de mi figura
      mandarme eso al buche. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Entiendo. Eso ser\xEDa todo"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Espero que encuentre pronto al responsable. Ser\xEDa una l\xE1stima
      que esto siguiera dando que hablar."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
