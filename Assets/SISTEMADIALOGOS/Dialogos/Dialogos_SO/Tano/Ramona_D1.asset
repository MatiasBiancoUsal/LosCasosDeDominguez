%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Ramona_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Buenas tardes. \xBFCon quien Hablo?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mercado familiar \"El Tano\", para servirle\u2026 \xBFQui\xE9n habla?\n"
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFMercado familiar? Mi nombre es Horacio Dom\xEDnguez. Soy detective
      privado. Encontr\xE9 su n\xFAmero en la casa de los Alvear."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFLos Alvear? Ah\u2026 s\xED. \xBFPas\xF3 algo?"
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Eso quisiera saber yo, se\xF1or. Encontr\xE9 una nota con su n\xFAmero
      y una frase bastante curiosa: \u201CTengo lo que quieren\u201D."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFQu\xE9? \xA1No, no, se\xF1or! \xA1Eso suena como una amenaza y
      no es ninguna amenaza!"
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Nadie ha mencionado una amenaza, se\xF1or Tano....."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Bueno disculpe\u2026 pero con esa frase cualquiera pensar\xEDa cualquier
      cosa. "
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Entonces expl\xEDqueme qu\xE9 significa."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mire, detective\u2026 yo encontr\xE9 una cosa que pertenece a esa familia
      y quise avisarles. Nada m\xE1s. "
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFQu\xE9 cosa? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: 'Una receta. '
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFUna receta? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "S\xED, una receta de familia. La encontr\xE9 entre las estanterias,
      me di cuenta que era de Consuelo por su caracteristica letra. La pobre ni se
      dio cuenta de que se le hab\xEDa ca\xEDdo. "
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFY usted fue quien llam\xF3 a los Alvear?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Claro. Les dije que la ten\xEDa guardada y que pod\xEDan pasar a buscarla
      cuando quisieran, pero ahora me doy cuenta que no me comprendieron..."
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 2331005228543377641, guid: 692a1aa7fb5f5bb4e8a2f8aefdeb2ab0, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFY por qu\xE9 no les dijo directamente que ten\xEDa la receta y
      EN ESPA\xD1OL?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1Porque pens\xE9 que sab\xEDan de qu\xE9 hablaba! \xBFQu\xE9 culpa
      tengo yo de que esa familia ande sospechando hasta de su propia sombra?"
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Me parece que ha habido un peque\xF1o malentendido."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFMalentendido? \xA1Espero que s\xED! Porque yo no tengo nada que
      ver con mafias ni amenazas. \xA1Yo s\xF3lo encontr\xE9 un papelito!"
    nombre: El Tano
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
