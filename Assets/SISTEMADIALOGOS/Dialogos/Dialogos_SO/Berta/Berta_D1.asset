%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Berta_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Buenos d\xEDas. Soy Horacio Dom\xEDnguez, detective. Quisiera hacerle
      unas preguntas sobre lo ocurrido anoche."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "S\xED, se\xF1or\u2026 Aunque todav\xEDa me cuesta creer que alguien
      haya hecho semejante cosa.\n"
    nombre: Berta, Cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Tengo entendido que usted ayud\xF3 a la se\xF1ora Consuelo con la preparaci\xF3n."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "As\xED es, se\xF1or. Estuve con ella en todo momento, menos cuando
      fue al mercado, ya que esa es su actividad preciada\u2026 Puso mucho empe\xF1o
      en prepararlas\u2026 pobrecita, estaba tan contenta con c\xF3mo hab\xEDan quedado."
    nombre: Berta, Cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Y en ese momento a solas.. \xBFQu\xE9 hizo usted?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Respond\xED una vez m\xE1s esas terror\xEDficas llamadas inentendibles 
      y luego, me fui a acostar temprano. Pero antes de hacerlo escuch\xE9 unos pasos
      en el pasillo de servicio. No llegu\xE9 a ver qui\xE9n era."
    nombre: Berta, Cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Esas llamadas causaron estragos en toda la familia al parecer.. \xBFLe
      parecieron extra\xF1os los pasos ?\r\n"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Un poquito, s\xED. Pero de seguro fue Elisa ya que casi siempre le
      cuesta conciliar el sue\xF1o. No quise andar metiendo las narices donde no
      me llamaban. "
    nombre: Berta, Cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Comprendo. \xBFRecuerda algo sobre la receta? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFLa receta? No, se\xF1or. La se\xF1ora Consuelo jam\xE1s la dejaba
      por ah\xED. Se la guardaba en el bolsillo y, si se olvidaba de alg\xFAn ingrediente,
      la sacaba y le echaba una miradita. "
    nombre: Berta, Cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Ya veo... Una ultima pregunta... \xBFconoce usted a una tal Ramona? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1Ramona! Mujer despreciable, es compinche de la se\xF1ora N\xE9lida,
      siempre estan hablando. Es vecina de esta honorable casona"
    nombre: Berta, cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFComo puedo acceder a su casa?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "A trav\xE9s del jard\xEDn. Elisa es la ama de llaves, ella debe tener
      acceso."
    nombre: Berta, cocinera
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 7643896951484177880, guid: 85d0ebfb5ee91904eabda0b835863239, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Muchas gracias, Berta. Es usted muy agradable. Resolver\xE9 este crimen
      por usted."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
