%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Hipolito_D2
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Se\xF1or Alvear, vuelvo con usted para hacer un par de preguntas m\xE1s.
      Debo admitir que hay algunos asuntos sobre sus andares que no me cuadran a\xFAn... "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "...una familia tan poderosa como la Alvear... ante las sospechas de
      una mafia o plan en su contra, deberia ser un esc\xE1ndalo. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "...uno creeria que tendrian contactos con la policia, la pol\xEDtica,
      y las grandes esferas de poder de la ciudad. Los mejores recursos a su favor..."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFPor qu\xE9 me contrat\xF3 a mi, se\xF1or?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Se\xF1or Dominguez, le ser\xE9 completamente franco: Lo que mas me
      llam\xF3 la atenci\xF3n de usted fue su baja cotizaci\xF3n. Es barato. As\xED
      de simple. \xBFPudo resolver el caso?"
    nombre: "Hip\xF3lito Alvear"
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Una raz\xF3n m\xE1s que v\xE1lida, se\xF1or, por su puesto... Aunque
      me sorprende viniendo de una familia como la suya. No me malentienda, pero
      mire el tama\xF1o de esta casa, claramente tienen generaciones de dinero."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: 'Si, hay mucho orgullo, historia y renombre en nuestro apellido, Dominguez.
      No comprendo a donde quiere llegar con esto. '
    nombre: Hipolito Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Me sorprende que no tengan un presupuesto mayor para emergencias, se\xF1or.
      Simplemente eso. Tengo entendido, como hombre de la casa, que usted administra
      las cuentas. \xBFHace cu\xE1nto se encagra de esa tarea? "
    nombre: Hipolito Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBF\xA1P-Pero qu\xE9 est\xE1 diciendo, se\xF1or!? \xBF\xA1Qu\xE9 quiere
      insuinar!? No me agrada para nada su tono. No lo contrat\xE9 par que me investigue
      a mi, sino para que resuelva el asunto de mi madre.  "
    nombre: Hipolito Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Tranquil\xEDcese, Hip\xF3lito. Simplemente hago preguntas. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Y creo haber conseguido las respuestas que buscaba, adi\xF3s. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
