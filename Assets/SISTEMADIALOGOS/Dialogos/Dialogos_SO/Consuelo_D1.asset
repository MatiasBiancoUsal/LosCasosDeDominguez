%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07ac2534796d0514490fda8dccd0ab15, type: 3}
  m_Name: Consuelo_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Usted debe ser el detective. \xA1Por el amor de Dios, ay\xFAdenos a
      esclarecer esta desgracia! Jam\xE1s imagin\xE9 que algo semejante pudiera ocurrir
      bajo este techo."
    nombre: CONSUELO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Muy buenos d\xEDas, se\xF1ora. En efecto, he venido para resolver el
      caso. Sin embargo, debo confesar que a\xFAn ignoro los detalles de lo acontecido."
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFC\xF3mo dice? \xBFNadie le ha informado todav\xEDa? \xA1Pero esto
      es inaudito! Deben ponerlo al corriente de inmediato, muchachito. \xBFC\xF3mo
      pretende hallar al culpable si lo mantienen en las sombras?"
    nombre: CONSUELO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Tiene raz\xF3n, se\xF1ora. Todo investigador precisa conocer los hechos
      antes de emitir juicio alguno."
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Pues entonces exija respuestas. En esta casa han ocurrido sucesos terribles,
      y no descansar\xE9 hasta ver esclarecida la verdad. Mi familia ha mantenido
      su honor intacto durante generaciones, y no permitir\xE9 que un esc\xE1ndalo
      lo manche ahora."
    nombre: CONSUELO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
