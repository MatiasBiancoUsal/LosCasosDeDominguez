%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07ac2534796d0514490fda8dccd0ab15, type: 3}
  m_Name: Elena_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Disculpe mi atrevimiento, se\xF1or, pero no creo haber tenido el gusto.
      \xBFQui\xE9n es usted? "
    nombre: ELENA ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 4709027056367343396, guid: 4383359beac50b34d884732327fdfbf4, type: 3}
    fondo: {fileID: 9001398115994798786, guid: b63f05c6376b3114cad32ac8fc7acc84, type: 3}
  - dialogo: Horacio Dominguez, detective privado. He sido requerido por la familia
      para investigar ciertos acontecimientos ocurridos en esta residencia durante
      la pasada noche.
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 9001398115994798786, guid: b63f05c6376b3114cad32ac8fc7acc84, type: 3}
  - dialogo: "Ah\u2026 un detective. Debo admitir que toda esta situaci\xF3n resulta
      de lo m\xE1s escandalosa. La casa no ha conocido sosiego desde el alba."
    nombre: ELENA ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 4709027056367343396, guid: 4383359beac50b34d884732327fdfbf4, type: 3}
    fondo: {fileID: 9001398115994798786, guid: b63f05c6376b3114cad32ac8fc7acc84, type: 3}
  - dialogo: "Entiendo, se\xF1orita. Toda circunstancia, por nimia que parezca, puede
      resultar de valor. \xBFQu\xE9 podr\xEDa decirme sobre lo sucedido?"
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 9001398115994798786, guid: b63f05c6376b3114cad32ac8fc7acc84, type: 3}
  - dialogo: "Mucho me temo que no ser\xE9 de gran ayuda. El incidente ocurri\xF3
      al anochecer y yo me retir\xE9 temprano a mis aposentos. Una se\xF1orita de
      buena familia debe procurar siempre su descanso; despu\xE9s de todo, las ocho
      horas de sue\xF1o son casi una obligaci\xF3n social."
    nombre: ELENA ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 4709027056367343396, guid: 4383359beac50b34d884732327fdfbf4, type: 3}
    fondo: {fileID: 9001398115994798786, guid: b63f05c6376b3114cad32ac8fc7acc84, type: 3}
