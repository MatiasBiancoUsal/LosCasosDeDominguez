%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07ac2534796d0514490fda8dccd0ab15, type: 3}
  m_Name: Hipolito_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Buenas noches, me presento Horacio Dom\xEDnguez"
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Hip\xF3lito Alvear, para servirlo."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Fui yo quien lo llam\xF3, don Horacio. Disculpe la hora, pero el asunto
      me tiene francamente alterado."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Cu\xE9nteme."
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "A mi madre le han hecho una canallada... Desaparecieron sus milanesas
      y tambi\xE9n el recetario, ese cuadernillo que guarda como un tesoro."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mmm\u2026 asunto espinoso. \xBFAlguna idea de qui\xE9n pudo haber sido?"
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "No quiero apresurarme a acusar a nadie... Pero mi hermana N\xE9lida...
      No me sorprender\xEDa que ella est\xE9 detr\xE1s de esto."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Aj\xE1\u2026 "
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mi madre qued\xF3 destrozada. Y le soy sincero, esto me supera."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Lo noto inquieto. Hay algo m\xE1s que no me est\xE1 diciendo...?"
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "No pretendo ocultarle nada, pero hay detalles que a\xFAn no estoy en
      condiciones de revelar."
    nombre: HIPOLITO ALVEAR
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 8604544167152943006, guid: ff395230f3b855a4d82435376cd230cc, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Est\xE1 bien. Cada cosa a su tiempo."
    nombre: HORACIO DOMINGUEZ
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
