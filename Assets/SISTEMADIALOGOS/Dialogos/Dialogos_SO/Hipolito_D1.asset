%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07ac2534796d0514490fda8dccd0ab15, type: 3}
  m_Name: Hipolito_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Buenas noches, me presento Horacio Dom\xEDnguez"
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Hip\xF3lito Alvear, para servirlo."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Fui yo quien lo llam\xF3, don Horacio. Disculpe la hora, pero el asunto
      me tiene francamente alterado."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Cu\xE9nteme."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: A mi madre le han hecho una canallada...
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Desaparecieron sus milanesas y tambi\xE9n el recetario, ese cuadernillo
      que guarda como un tesoro."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Mmm\u2026 asunto espinoso."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: "\xBFAlguna idea de qui\xE9n pudo haber sido?"
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: No quiero apresurarme a acusar a nadie
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Pero mi hermana N\xE9lida... No me sorprender\xEDa que ella est\xE9
      detr\xE1s de esto."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Aj\xE1\u2026 "
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Mi madre qued\xF3 destrozada. Y le soy sincero, esto me supera."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Lo noto inquieto. Hay algo m\xE1s que no me est\xE1 diciendo...?"
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
  - dialogo: "No pretendo ocultarle nada, pero hay detalles que a\xFAn no estoy en
      condiciones de revelar."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: 6235484382963830118, guid: 89a858d8e1970854f8bff6a42e34b52d, type: 3}
    fondo: {fileID: 0}
  - dialogo: "Est\xE1 bien. Cada cosa a su tiempo."
    nombre: 
    cuadrodialogo: {fileID: 0}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 0}
