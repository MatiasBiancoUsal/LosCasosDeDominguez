%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Domingo_D1
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: " \xA1Muy buenos d\xEDas, caballero! \xBFA qu\xE9 debemos el placer
      de su visita a esta modesta morada?"
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Buenos d\xEDas, joven. He sido convocado para esclarecer un caso tan
      lamentable como espeluznante ocurrido durante la noche."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFUn caso espeluznante, dice usted? Vaya, vaya\u2026 qu\xE9 asunto
      tan sombr\xEDo. D\xEDgame una cosa, detective: \xBFcree usted que esta camisa
      luce mejor con el bot\xF3n del cuello cerrado o ser\xEDa demasiado formal?"
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: Me sorprende verlo tan sereno dadas las circunstancias.
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mi querido se\xF1or, la elegancia jam\xE1s debe abandonarse, ni siquiera
      en tiempos de desgracia. Adem\xE1s, uno nunca sabe cu\xE1ndo puede cruzarse
      con una dama digna de admiraci\xF3n."
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Comprendo. Creo que por ahora no tengo m\xE1s preguntas. Si me disculpa,
      continuar\xE9 con mis averiguaciones."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Desde luego, detective. Y si descubre al culpable, h\xE1gamelo saber.
      La incertidumbre arruina m\xE1s caballeros que el esc\xE1ndalo."
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
