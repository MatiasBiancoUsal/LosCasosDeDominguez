%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Domingo_D2
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Don Domingo. Estuve revisando la escena del crimen... o mejor dicho,
      los rincones m\xE1s inesperados de esta casa. Me top\xE9 con un objeto muy
      particular en la cocina."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFEn la cocina, dice? V\xE1lgame Dios, detective. No ten\xEDa entendido
      que las ollas y los sartenes guardaran secretos tan fascinantes. \xBFAcaso
      hall\xF3 la bendita receta de mi abuela?"
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " No exactamente. Hall\xE9 esto cerca de la alacena. Un reloj de bolsillo
      fin\xEDsimo, con las iniciales D.A. grabadas en el reverso. Dir\xEDa que de
      porte compadrito, pero con demasiado bul\xF3n."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " \xA1V\xE1lgame Dios! \xBFMi reloj de bolsillo? Qu\xE9 distracci\xF3n...
      Debe hab\xE9rseme ca\xEDdo anoche en alg\xFAn momento del traj\xEDn. Uno anda
      a las corridas y, chau pinela, el b\xE1rtulo desaparece. "
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mmm \xBFAnoche dijo usted? Qu\xE9 curioso que se le caiga justo en
      la cocina, y a altas horas de la noche, cuando todos dorm\xEDan. \xBFBuscaba
      un bajativo a oscuras? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1Qu\xE9 man\xEDa la suya de ver moros con chuzas, detective! \xBFUn
      alma no puede tener un antojo nocturno? Un vasito de leche para el insomnio,
      nada m\xE1s.  "
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Lo que llama la atenci\xF3n no es el insomnio, sino la compa\xF1\xEDa\u2026
      Seg\xFAn me comentaron, la ama de llaves andaba por el mismo sector a esa hora.
      \xBFCasualidad?  "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " \xA1Cuidado con el tono! \xA1D\xE9jese de milongas, detective! \xBFMe
      va a devolver el reloj o me lo va a confiscar? Le aviso que a m\xED la impuntualidad
      me da alergia. "
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Era solo una consulta Domingo, no deber\xEDa de exaltarse de esa manera\u2026
      Lo dejo por el momento. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
