  - dialogo: INTERROGAR
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Comprendo. Creo que por ahora no tengo m\xE1s preguntas. Si me disculpa,
      continuar\xE9 con mis averiguaciones."
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Desde luego, detective. Y si descubre al culpable, h\xE1gamelo saber.
      La incertidumbre arruina m\xE1s caballeros que el esc\xE1ndalo."
    nombre: Domingo Alvear
    cuadrodialogo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1982320374254805862, guid: 62f1c385c6416b4419da0a1089991296, type: 3}
    fondo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
