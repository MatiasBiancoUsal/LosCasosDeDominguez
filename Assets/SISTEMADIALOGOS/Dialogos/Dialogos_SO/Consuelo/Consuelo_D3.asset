%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Consuelo_D3
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Se\xF1ora Consuelo, estuve investigando los llamados extra\xF1os que
      recibi\xF3 la familia. Tengo buenas noticias: puede quedarse tranquila. No
      hay ninguna conspiraci\xF3n de la mafia italiana detr\xE1s de todo esto. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFQu\xE9 dice, muchachito? \xBFC\xF3mo que no es la mafia? \xA1Si
      ese hombre llamaba a altas horas y hablaba en un cocoliche incomprensible!
      Mis nervios no aguantaban un minuto m\xE1s. "
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Era simplemente el Tano, el due\xF1o del mercado del barrio. Resulta
      que encontr\xF3 su famosa receta de milanesas dentro de una alacena. "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " Estuvo intentando comunicarse todo este tiempo para devolv\xE9rsela,
      pero como ustedes le respond\xEDan con tanto susto, el pobre hombre se pon\xEDa
      nervioso y le sal\xEDa el italiano de golpe.\r\n "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " \xA1\xBFEl Tano de la verduler\xEDa?! V\xE1lgame Dios... \xA1Y yo
      pens\xE9 que nos iba a secuestrar la \"Mano Negra\"! Qu\xE9 papel\xF3n, por
      favor... Pero bueno, al menos la receta apareci\xF3.\r\n\r\n "
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "As\xED es. El misterio del complot mafioso est\xE1 resuelto. Pero el
      robo de las milanesas en s\xED mismo sigue en pie. Pensando en fr\xEDo, do\xF1a
      Consuelo\u2026 \xBFQui\xE9n cree que pudo haberse atrevido a probar semejante
      manjar? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Mire, Horacio, en esta casa todos son capaces de cualquier travesura
      por dinero o capricho, menos una persona, Isabel, la esposa de mi hijo Hip\xF3lito.
      De eso pongo las manos en el fuego. "
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xBFY eso por qu\xE9, se\xF1ora? \xBFLe sobra honestidad a su nuera?"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "\xA1No, hombre, qu\xE9 honestidad ni qu\xE9 ocho cuartos! Lo que le
      sobra es obsesi\xF3n con la balanza. Isabel est\xE1 loca de remate con la comida,
      vive a base de lechuga y ag\xFCita mineral."
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " Dice que mis milanesas son un atentado a la salud p\xFAblica y que
      tienen m\xE1s calor\xEDas que una locomotora a vapor. Ni loca tocar\xEDa semejante
      pecado culinario."
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: " Aun no he logrado ponerme en contacto con ella\u2026"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Berta debe de saber en donde se encuentra, siempre est\xE1 recordandol\xE9
      que coma algo..\r\n"
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
