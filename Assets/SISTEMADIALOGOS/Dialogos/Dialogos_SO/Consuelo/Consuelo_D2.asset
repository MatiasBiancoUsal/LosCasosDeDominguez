  m_Script: {fileID: 11500000, guid: f230adbc80bcc584a914dc143b282761, type: 3}
  m_Name: Consuelo_D2
  m_EditorClassIdentifier: Assembly-CSharp::DialogoSistema
  dialogos:
  - dialogo: "Se\xF1ora consuelo, aun me encuentro en periodo de investigaciones"
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "He tenido conversaciones interesantes con sus dos hijos. No tienen
      la m\xE1s cercana de las relaciones... "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Oh, mis hijos. Los adoro, pero no los comprendo. Nunca se llevaron
      bien. Nelida siempre fue muy sensata. Hip\xF3lito, por su parte... es mas...irracional. "
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: 'Mmm, ya veo. '
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Disculpe el atrevimiento, pero me han comentado que usted tiene el
      acceso a la cocina. \xBFSeria tan amable de permitirme inspeciconarla? "
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: 'Despues de todo, no puedo resolver un misterio sin inspeccionar la
      escena del crimen. '
    nombre: Horacio Dominguez
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: -4301562977008557405, guid: 066074642f61c0d44a7539cd288a18ca, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Todo debe estar tal cual lo encontr\xE9 en al ma\xF1ana. Disculpe que
      no lo puedo acopa\xF1ar, la angustia no me lo permite. La deje a Berta cuidando
      la zona."
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
  - dialogo: "Aqu\xED tiene la llave."
    nombre: Consuelo Alvear
    cuadrodialogo: {fileID: -103428560146978602, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
    personaje: {fileID: 1288810407429529840, guid: 4c5e0a06e04ebd14ca4feed096fbff39, type: 3}
    fondo: {fileID: 5873544265073860004, guid: e87ff4b4b43252d41a33b56c9a3e25a9, type: 3}
